<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:camunda="http://camunda.org/schema/1.0/bpmn"
                  targetNamespace="http://bpmn.io/schema/bpmn">

  <bpmn:process id="validation-teletravail"
                name="Validation Télétravail"
                isExecutable="true"
                camunda:historyTimeToLive="30">

    <bpmn:startEvent id="StartEvent" name="Début">
      <bpmn:outgoing>Flow1</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:userTask id="ChefValidation" name="Validation Chef">
      <bpmn:extensionElements>
        <camunda:inputOutput>
          <camunda:inputParameter name="assignee">
            <camunda:expression>${chefEmail}</camunda:expression>
          </camunda:inputParameter>
        </camunda:inputOutput>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow1</bpmn:incoming>
      <bpmn:outgoing>Flow2</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Tâche Admin assignée à admin@siga.com -->
    <bpmn:userTask id="AdminValidation" name="Validation Admin">
      <bpmn:extensionElements>
        <camunda:inputOutput>
          <camunda:inputParameter name="assignee">
            <camunda:expression>${adminEmail}</camunda:expression>
          </camunda:inputParameter>
        </camunda:inputOutput>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow2</bpmn:incoming>
      <bpmn:outgoing>Flow3</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:endEvent id="EndEvent" name="Fin">
      <bpmn:incoming>Flow3</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="Flow1" sourceRef="StartEvent" targetRef="ChefValidation"/>
    <bpmn:sequenceFlow id="Flow2" sourceRef="ChefValidation" targetRef="AdminValidation"/>
    <bpmn:sequenceFlow id="Flow3" sourceRef="AdminValidation" targetRef="EndEvent"/>

  </bpmn:process>

</bpmn:definitions>